---
import Logo from './Logo.astro';
import Icon from './Icon.astro';
import { copy, contact, type Lang } from '../data/site';
const { lang } = Astro.props as { lang: Lang };
const t = copy[lang];
---
<footer class="footer">
  <div class="container top">
    <div class="brand"><span class="mark"><Logo size={56} /></span><p>{t.footer.tagline}</p></div>
    <nav aria-label="Footer">
      <a href="#services">{t.nav.services}</a><a href="#work">{t.nav.work}</a><a href="#process">{t.nav.process}</a><a href="#contact">{t.nav.contact}</a>
    </nav>
    <div class="links">
      <a href={`tel:${contact.phoneIntl}`}><Icon name="phone" />{contact.phone}</a>
      <a href={`mailto:${contact.email}`}><Icon name="mail" />{contact.email}</a>
      <a href={contact.facebook} target="_blank" rel="noopener"><Icon name="facebook" />Facebook</a>
    </div>
  </div>
  <div class="giant" aria-hidden="true" data-giant>{'Prottoya'.split('').map((c) => <span>{c}</span>)}</div>
  <div class="container bottom">
    <span>© {new Date().getFullYear()} {t.name}. {t.footer.rights}</span>
    <span class="cmyk" aria-hidden="true"><i></i><i></i><i></i><i></i></span>
  </div>
</footer>

<style>
  .footer { background: var(--invert-bg); color: var(--invert-text); padding-top: clamp(4rem, 8vw, 7rem); overflow: hidden; }
  .top { display: grid; grid-template-columns: 1.4fr 1fr 1fr; gap: 2rem; }
  .brand { display: grid; gap: 1.2rem; max-width: 26rem; font-size: var(--step-1); line-height: 1.4; }
  .mark { color: var(--cyan); }
  nav, .links { display: grid; gap: 0.7rem; align-content: start; }
  a { text-decoration: none; opacity: 0.8; transition: opacity 0.2s, color 0.2s; display: inline-flex; gap: 0.6rem; align-items: center; width: fit-content; overflow-wrap: anywhere; }
  a:hover { opacity: 1; color: var(--cyan); }
  a :global(svg) { width: 1.1rem; height: 1.1rem; }
  .giant { display: flex; justify-content: center; font-family: var(--font-display); font-weight: 800; font-size: clamp(4rem, 19.5vw, 22rem); letter-spacing: -0.06em; line-height: 0.8; margin-top: clamp(3rem, 6vw, 5rem); color: var(--cyan); user-select: none; }
  .giant span { display: inline-block; transition: color 0.3s, transform 0.5s var(--ease-out); }
  .giant span:hover { transform: translateY(-0.08em); }
  .giant span:nth-child(3n + 1):hover { color: var(--magenta); }
  .giant span:nth-child(3n + 2):hover { color: var(--yellow); }
  .giant span:nth-child(3n):hover { color: var(--orange); }
  .bottom { display: flex; justify-content: space-between; align-items: center; gap: 1rem; padding-block: 1.6rem; font-size: 0.85rem; opacity: 0.75; flex-wrap: wrap; }
  .cmyk { display: flex; gap: 6px; }
  .cmyk i { width: 10px; height: 10px; border-radius: 50%; background: var(--cyan); }
  .cmyk i:nth-child(2) { background: var(--magenta); }
  .cmyk i:nth-child(3) { background: var(--yellow); }
  .cmyk i:nth-child(4) { background: var(--invert-text); }
  @media (max-width: 760px) { .top { grid-template-columns: 1fr 1fr; } .brand { grid-column: 1 / -1; } }
</style>

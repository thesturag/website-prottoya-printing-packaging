---
import Logo from './Logo.astro';
import Icon from './Icon.astro';
import { copy, contact, type Lang } from '../data/site';
const { lang } = Astro.props as { lang: Lang };
const t = copy[lang];
---
<footer class="footer">
  <div class="container row">
    <div class="brand"><span class="mark"><Logo size={32} /></span><span>{t.name}</span></div>
    <nav aria-label="Footer">
      <a href="#services">{t.nav.services}</a><a href="#work">{t.nav.work}</a><a href="#process">{t.nav.process}</a><a href="#contact">{t.nav.contact}</a>
    </nav>
    <div class="links">
      <a href={`tel:${contact.phoneIntl}`} aria-label={contact.phone}><Icon name="phone" /></a>
      <a href={`mailto:${contact.email}`} aria-label={contact.email}><Icon name="mail" /></a>
      <a href={contact.facebook} target="_blank" rel="noopener" aria-label="Facebook"><Icon name="facebook" /></a>
    </div>
  </div>
  <div class="container bottom">
    <span>© {new Date().getFullYear()} {t.name}. {t.footer.rights}</span>
    <span>{t.footer.tagline}</span>
  </div>
</footer>

<style>
  .footer { background: var(--invert-bg); color: var(--invert-text); padding-top: 2.5rem; }
  .row { display: flex; flex-wrap: wrap; align-items: center; justify-content: space-between; gap: 1.25rem 2rem; padding-bottom: 1.75rem; border-bottom: 1px solid color-mix(in srgb, var(--invert-text) 14%, transparent); }
  .brand { display: flex; align-items: center; gap: 0.7rem; font-family: var(--font-display); font-weight: 700; font-size: 1.1rem; }
  .mark { color: var(--cyan); display: flex; }
  nav { display: flex; flex-wrap: wrap; gap: 0.4rem 1.5rem; font-size: 0.92rem; }
  .links { display: flex; gap: 0.5rem; }
  a { text-decoration: none; opacity: 0.75; transition: opacity 0.2s, color 0.2s; }
  a:hover { opacity: 1; color: var(--cyan); }
  .links a { display: grid; place-items: center; width: 2.4rem; height: 2.4rem; border-radius: 50%; box-shadow: inset 0 0 0 1px color-mix(in srgb, var(--invert-text) 18%, transparent); }
  .links a :global(svg) { width: 1rem; height: 1rem; }
  @media (max-width: 900px) {
    nav a { padding-block: 0.7rem; }
    .links a { width: 2.75rem; height: 2.75rem; }
  }
  .bottom { display: flex; justify-content: space-between; gap: 0.5rem 1rem; flex-wrap: wrap; padding-block: 1.25rem; font-size: 0.8rem; opacity: 0.6; }
</style>

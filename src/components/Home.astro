---
import { t, type Lang } from '../i18n';
const { lang } = Astro.props as { lang: Lang };
const copy = t(lang);
const marquee = [...copy.marquee, ...copy.marquee];
---
<section class="hero">
  <div class="container">
    <p class="eyebrow" data-reveal>{copy.hero.eyebrow}</p>
    <h1 data-reveal>{copy.hero.title}</h1>
    <a class="btn" href="#contact" data-reveal>{copy.hero.cta}</a>
  </div>
</section>

<div class="marquee" aria-hidden="true">
  <div class="track" data-marquee>
    {marquee.map((item) => <span>{item}<i>✦</i></span>)}
  </div>
</div>

{(['services', 'work', 'process', 'about', 'contact'] as const).map((id) => (
  <section id={id}>
    <div class="container">
      <h2 data-reveal>{copy.sections[id]}</h2>
    </div>
  </section>
))}

<style>
  .hero { min-height: 100svh; display: grid; align-items: end; padding-bottom: clamp(3rem, 8vw, 6rem); }
  .eyebrow { color: var(--brand); font-weight: 600; text-transform: uppercase; letter-spacing: 0.12em; font-size: 0.85rem; }
  h1 { font-size: var(--step-4); max-width: 12ch; margin-block: 1rem 2rem; }
  h2 { font-size: var(--step-3); }
  .btn { display: inline-block; background: var(--brand); color: var(--brand-ink); padding: 1rem 1.75rem; border-radius: 999px; text-decoration: none; font-weight: 600; transition: transform 0.3s var(--ease-out); }
  .btn:hover { transform: translateY(-3px); }
  .marquee { overflow: hidden; border-block: 1px solid var(--line); padding-block: 1.25rem; }
  .track { display: flex; width: max-content; font-family: var(--font-display); font-size: var(--step-2); white-space: nowrap; }
  .track span { padding-inline: 1.5rem; }
  .track i { font-style: normal; color: var(--brand); margin-left: 3rem; }
</style>

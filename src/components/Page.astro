---
import Base from '../layouts/Base.astro';
import Hero from './Hero.astro';
import Marquee from './Marquee.astro';
import Services from './Services.astro';
import Work from './Work.astro';
import Process from './Process.astro';
import Contact from './Contact.astro';
import type { Lang } from '../data/site';
const { lang } = Astro.props as { lang: Lang };
---
<Base lang={lang}>
  <Hero lang={lang} />
  <Marquee lang={lang} />
  <Services lang={lang} />
  <Work lang={lang} />
  <Marquee lang={lang} reverse />
  <div style="height: clamp(3rem, 6vw, 5rem)"></div>
  <Process lang={lang} />
  <Contact lang={lang} />
</Base>

---
import Logo from './Logo.astro';
import Icon from './Icon.astro';
import { copy, type Lang } from '../data/site';
const { lang } = Astro.props as { lang: Lang };
const t = copy[lang];
const other = lang === 'en' ? '/bn/' : '/';
---
<header class="header" data-header>
  <div class="container bar">
    <a class="brand" href={lang === 'en' ? '/' : '/bn/'} aria-label={t.name}>
      <span class="mark"><Logo size={34} /></span>
      <span class="word">Prottoya<small>{lang === 'en' ? 'Printing & Packaging' : 'প্রিন্টিং ও প্যাকেজিং'}</small></span>
    </a>
    <nav class="nav" aria-label="Primary">
      <a href="#services">{t.nav.services}</a>
      <a href="#work">{t.nav.work}</a>
      <a href="#process">{t.nav.process}</a><a href="#visit">{t.nav.display}</a>
      <a href="#contact">{t.nav.contact}</a>
    </nav>
    <div class="actions">
      <button class="chip icon menu-btn" type="button" aria-expanded="false" aria-controls="mnav" aria-label={lang === 'en' ? 'Menu' : 'মেনু'} data-menu-toggle>
        <span class="bars" aria-hidden="true"><i></i><i></i></span>
      </button>
      <a class="chip lang" href={other} hreflang={lang === 'en' ? 'bn' : 'en'} lang={lang === 'en' ? 'bn' : 'en'} aria-label={t.toggles.langLabel}>{t.toggles.lang}</a>
      <button class="chip icon" type="button" data-theme-toggle aria-label={t.toggles.theme}>
        <span class="sun"><Icon name="sun" /></span><span class="moon"><Icon name="moon" /></span>
      </button>
      <a class="btn small" href="#contact" data-magnetic>{t.nav.quote}</a>
    </div>
  </div>
  <nav class="mnav container" id="mnav" aria-label="Primary" hidden data-menu>
    <a href="#services">{t.nav.services}</a>
    <a href="#work">{t.nav.work}</a>
    <a href="#process">{t.nav.process}</a><a href="#visit">{t.nav.display}</a>
    <a href="#contact">{t.nav.contact}</a>
    <a class="btn" href="#contact">{t.nav.quote}</a>
  </nav>
</header>

<script>
  const btn = document.querySelector<HTMLButtonElement>('[data-menu-toggle]');
  const menu = document.querySelector<HTMLElement>('[data-menu]');
  if (btn && menu) {
    const set = (open: boolean) => { btn.setAttribute('aria-expanded', String(open)); menu.hidden = !open; };
    btn.addEventListener('click', () => set(menu.hidden));
    menu.addEventListener('click', (e) => { if ((e.target as Element).closest('a')) set(false); });
    addEventListener('keydown', (e) => { if (e.key === 'Escape' && !menu.hidden) { set(false); btn.focus(); } });
    matchMedia('(min-width: 961px)').addEventListener('change', (m) => m.matches && set(false));
  }
</script>

<style>
  .header { position: fixed; inset: 0 0 auto; z-index: 50; padding-block: 0.9rem; transition: transform 0.5s var(--ease-out), background-color 0.3s, box-shadow 0.3s; }
  .header.scrolled { background: color-mix(in srgb, var(--bg) 78%, transparent); backdrop-filter: blur(16px) saturate(1.4); -webkit-backdrop-filter: blur(16px) saturate(1.4); box-shadow: 0 1px 0 var(--line); }
  .header.hidden { transform: translateY(-110%); }
  .bar { display: flex; align-items: center; justify-content: space-between; gap: 1rem; }
  .brand { display: flex; align-items: center; gap: 0.7rem; text-decoration: none; }
  .mark { color: var(--cyan); display: grid; transition: transform 0.8s var(--ease-out); }
  .brand:hover .mark { transform: rotate(-60deg); }
  .word { font-family: var(--font-display); font-weight: 800; font-size: 1.35rem; letter-spacing: -0.03em; line-height: 1; display: grid; }
  .word small { font-family: var(--font-sans); font-weight: 500; font-size: 0.6875rem; letter-spacing: 0.06em; text-transform: uppercase; color: var(--muted); margin-top: 0.2rem; }
  .nav { display: flex; gap: 0.25rem; padding: 0.3rem; border-radius: 999px; background: color-mix(in srgb, var(--surface) 70%, transparent); box-shadow: inset 0 0 0 1px var(--line); }
  .nav a { text-decoration: none; padding: 0.45rem 1rem; border-radius: 999px; font-size: 0.95rem; font-weight: 500; transition: background-color 0.25s, color 0.25s; }
  .nav a:hover { background: var(--text); color: var(--bg); }
  .actions { display: flex; align-items: center; gap: 0.5rem; }
  .chip { display: inline-grid; place-items: center; height: 2.6rem; min-width: 2.6rem; padding-inline: 0.9rem; border-radius: 999px; border: 0; background: transparent; box-shadow: inset 0 0 0 1px var(--line); text-decoration: none; font-size: 0.9rem; font-weight: 600; cursor: pointer; transition: background-color 0.25s, color 0.25s; }
  .chip:hover { background: var(--text); color: var(--bg); }
  .chip.lang:lang(bn) { font-family: 'Hind Siliguri', sans-serif; }
  .chip.icon { padding: 0; }
  .chip :global(svg) { width: 1.15rem; height: 1.15rem; }
  .chip .sun, .chip .moon { grid-area: 1 / 1; display: grid; transition: transform 0.5s var(--ease-out), opacity 0.3s; }
  :global([data-theme='dark']) .chip .sun, :global([data-theme='light']) .chip .moon { transform: rotate(-90deg) scale(0.4); opacity: 0; }
  .btn.small { padding: 0.7rem 1.2rem; font-size: 0.92rem; }
  .menu-btn { display: none; }
  .bars { display: grid; gap: 5px; width: 1.1rem; }
  .bars i { display: block; height: 2px; border-radius: 2px; background: currentColor; transition: transform 0.35s var(--ease-out); }
  [aria-expanded='true'] .bars i:first-child { transform: translateY(3.5px) rotate(45deg); }
  [aria-expanded='true'] .bars i:last-child { transform: translateY(-3.5px) rotate(-45deg); }
  .mnav { display: grid; gap: 0.25rem; margin-top: 0.75rem; padding: 0.75rem; border-radius: var(--radius); background: var(--surface); box-shadow: 0 0 0 1px var(--line), 0 20px 40px -24px rgb(0 0 0 / 0.35); }
  .mnav[hidden] { display: none; }
  .mnav a:not(.btn) { text-decoration: none; padding: 0.8rem 0.75rem; border-radius: 0.75rem; font-weight: 600; font-size: var(--step-1); }
  .mnav a:not(.btn):hover { background: var(--surface-2); }
  .mnav .btn { justify-content: center; margin-top: 0.4rem; }
  @media (max-width: 960px) { .nav { display: none; } .menu-btn { display: inline-grid; } }
  @media (max-width: 900px) { .chip { height: 2.75rem; min-width: 2.75rem; } }
  @media (max-width: 560px) { .btn.small { display: none; } .word small { display: none; } }
</style>

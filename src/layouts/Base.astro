---
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { copy, contact, type Lang } from '../data/site';

const { lang } = Astro.props as { lang: Lang };
const t = copy[lang];
const site = Astro.site ?? new URL('https://prottoya.vercel.app');
const canonical = new URL(lang === 'en' ? '/' : '/bn/', site);
const schema = {
  '@context': 'https://schema.org',
  '@type': 'LocalBusiness',
  name: copy.en.name,
  alternateName: copy.bn.name,
  description: copy.en.meta.description,
  telephone: contact.phoneIntl,
  email: contact.email,
  url: site.href,
  logo: new URL('/logo-mark.svg', site).href,
  image: new URL('/og.jpg', site).href,
  sameAs: [contact.facebook],
  openingHours: 'Mo-Su 00:00-23:59',
  address: { '@type': 'PostalAddress', streetAddress: '18, Sayed Hasan Ali Lane, Babu Bazar', addressLocality: 'Dhaka', postalCode: '1100', addressCountry: 'BD' },
  areaServed: ['Dhaka', 'Gazipur', 'Narayanganj', 'Chittagong', "Cox's Bazar", 'Khulna', 'Rajshahi', 'Sylhet', 'Barisal', 'Dinajpur'],
};
---
<!doctype html>
<html lang={lang} data-theme="light">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{t.meta.title}</title>
    <meta name="description" content={t.meta.description} />
    <link rel="canonical" href={canonical} />
    <link rel="alternate" hreflang="en" href={new URL('/', site)} />
    <link rel="alternate" hreflang="bn" href={new URL('/bn/', site)} />
    <link rel="alternate" hreflang="x-default" href={new URL('/', site)} />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={t.meta.title} />
    <meta property="og:description" content={t.meta.description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={new URL('/og.jpg', site)} />
    <meta property="og:locale" content={lang === 'en' ? 'en_US' : 'bn_BD'} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="theme-color" content="#13abe4" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Bricolage+Grotesque:opsz,wght@12..96,500..800&family=Hind+Siliguri:wght@400;500;600;700&family=Inter+Tight:wght@400;500;600;700&display=swap" />
    <script is:inline>
      (() => {
        let theme;
        try { theme = localStorage.getItem('theme'); } catch {}
        if (theme !== 'light' && theme !== 'dark') theme = matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light';
        const root = document.documentElement;
        root.dataset.theme = theme;
        if (!matchMedia('(prefers-reduced-motion: reduce)').matches) root.classList.add('js-motion');
      })();
    </script>
    <script type="application/ld+json" set:html={JSON.stringify(schema)} />
  </head>
  <body>
    <Header lang={lang} />
    <main><slot /></main>
    <Footer lang={lang} />
    <a class="wa-float" href={`https://wa.me/${contact.whatsapp}`} target="_blank" rel="noopener" aria-label="WhatsApp">
      <svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M12.04 2a9.9 9.9 0 0 0-8.5 15l-1.4 5 5.1-1.3A9.9 9.9 0 1 0 12.04 2Zm0 18.1a8.2 8.2 0 0 1-4.2-1.2l-.3-.2-3 .8.8-2.9-.2-.3a8.2 8.2 0 1 1 6.9 3.8Zm4.5-6.1c-.2-.1-1.5-.7-1.7-.8-.2-.1-.4-.1-.6.1l-.8 1c-.1.2-.3.2-.5.1a6.7 6.7 0 0 1-3.3-2.9c-.3-.4.2-.4.7-1.3.1-.2 0-.3 0-.4l-.8-1.8c-.2-.5-.4-.4-.6-.4h-.5a1 1 0 0 0-.7.3 3 3 0 0 0-.9 2.2 5.2 5.2 0 0 0 1.1 2.7 11.9 11.9 0 0 0 4.6 4c1.7.7 2.3.8 3.2.7.5-.1 1.5-.6 1.8-1.2.2-.6.2-1.1.1-1.2l-.5-.3Z"/></svg>
    </a>
    <script>
      import '../scripts/main';
    </script>
  </body>
</html>

<style is:global>
  .wa-float { position: fixed; right: 1.1rem; bottom: 1.1rem; z-index: 45; width: 3.5rem; height: 3.5rem; border-radius: 50%; display: grid; place-items: center; background: #25d366; color: #fff; box-shadow: 0 12px 30px -8px rgb(37 211 102 / 0.6); transition: transform 0.4s var(--ease-out); }
  .wa-float:hover { transform: scale(1.08) rotate(-8deg); }
  .wa-float svg { width: 1.7rem; height: 1.7rem; }
</style>
